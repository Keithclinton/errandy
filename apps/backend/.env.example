# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL. DATABASE_URL is the app's; DIRECT_URL is for Prisma migrations and backups (it
# differs only behind a connection pooler). These are docker-compose's. In production, the hosting
# account's own database (see deploy/cpanel/README.md):
#   postgresql://USER:PASSWORD@localhost:5432/DB?schema=public&sslmode=disable, plus
#   &connection_limit=5 on DATABASE_URL (the server's 100 connections are shared with other accounts)
DATABASE_URL="postgresql://errandy:errandy@localhost:5434/errandy_dev?schema=public"
DIRECT_URL="postgresql://errandy:errandy@localhost:5434/errandy_dev?schema=public"
# Production only: a database elsewhere that backup.sh loads each night's backup into.
# NEON_BACKUP_URL=

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Africa's Talking (SMS OTP for phone verification) — leave blank to log codes instead of sending
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# M-Pesa (Daraja STK Push on a Paybill, for buying tokens).
# With every MPESA_* value below filled in, purchases charge for real. With any missing,
# purchases are refused, unless MPESA_SIMULATE=true, which completes every purchase
# instantly for free. Use that for local dev only, never in production. Credentials
# always win over MPESA_SIMULATE.
# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# The Paybill number (Daraja's sandbox Paybill is 174379)
MPESA_SHORTCODE=
# The Lipa Na M-Pesa Online passkey issued for that shortcode
MPESA_PASSKEY=
# Public HTTPS URL of the callback route. Daraja can't reach localhost, so test the real
# flow on a deployment. MPESA_CALLBACK_SECRET is appended as the last path segment so only
# Safaricom knows the full URL; generate it with `openssl rand -hex 32`.
MPESA_CALLBACK_URL=https://your-domain.example/api/tokens/purchases/payment-callback
MPESA_CALLBACK_SECRET=
MPESA_SIMULATE=true

# Where uploaded photos are kept (see src/photos/photos.service.ts). Locally: ./uploads. On the
# server it must be set, to a folder the web server publishes at /uploads and that deploys don't
# replace: /home/<account>/public_html/uploads.
# UPLOADS_DIR=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@errandspot.app

# Vercel Cron
CRON_SECRET=changeme-cron-secret

# Sentry
SENTRY_DSN=

# Requests per minute per route: 100 per signed-in account, 300 per address otherwise (see
# src/common/rate-limits.ts). This replaces both. Only set it for a load test, then remove it.
# THROTTLE_LIMIT_PER_MINUTE=
