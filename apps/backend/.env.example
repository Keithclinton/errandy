# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Neon Postgres — use the pooled connection string for the app,
# and the direct (unpooled) string for Prisma migrations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/errandy?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/errandy?sslmode=require"

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Africa's Talking (SMS OTP for phone verification) — leave blank to log codes instead of sending
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# M-Pesa (Daraja STK Push on a Paybill, for buying tokens).
# With every MPESA_* value below filled in, purchases charge for real. With any missing,
# purchases are refused, unless MPESA_SIMULATE=true, which completes every purchase
# instantly for free. Use that for local dev only, never in production. Credentials
# always win over MPESA_SIMULATE.
# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# The Paybill number (Daraja's sandbox Paybill is 174379)
MPESA_SHORTCODE=
# The Lipa Na M-Pesa Online passkey issued for that shortcode
MPESA_PASSKEY=
# Public HTTPS URL of the callback route. Daraja can't reach localhost, so test the real
# flow on a deployment. MPESA_CALLBACK_SECRET is appended as the last path segment so only
# Safaricom knows the full URL; generate it with `openssl rand -hex 32`.
MPESA_CALLBACK_URL=https://your-domain.example/api/tokens/purchases/payment-callback
MPESA_CALLBACK_SECRET=
MPESA_SIMULATE=true

# Vercel Blob (image storage)
BLOB_READ_WRITE_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@errandspot.app

# Vercel Cron
CRON_SECRET=changeme-cron-secret

# Sentry
SENTRY_DSN=
